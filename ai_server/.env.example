# Never expose this key to the browser or commit a populated .env file.
APPWRITE_ENDPOINT="https://cloud.appwrite.io/v1"
APPWRITE_PROJECT_ID=your-project-id
APPWRITE_API_KEY=server-api-key-with-databases-read-write
APPWRITE_DATABASE_ID=safekeep
APPWRITE_ITEMS_COLLECTION_ID=items
APPWRITE_VERIFICATIONS_COLLECTION_ID=verifications
APPWRITE_MATCHES_COLLECTION_ID=matches
APPWRITE_CLAIMS_COLLECTION_ID=claims
APPWRITE_MESSAGES_COLLECTION_ID=messages
CORS_ORIGINS=http://localhost:5173
MATCH_THRESHOLD=0.60
MODEL_CACHE=./model_cache
LOG_LEVEL=INFO
